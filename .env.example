# payzeno-api — every variable read by src/config/configuration.ts.
# in the same PR — CI checks the three lists match.
#
# Values below are the docker-compose ones. Nothing here is a real secret.

# --- runtime -----------------------------------------------------------------
LEDGER_BASE_URL=http://payzeno-ledger:8000
# --- payzeno-billing-legacy (basic auth — hlegacy's service, do not "improve" it)
# --- card vault (PCI: the ONLY component that ever sees a PAN) -----------------
WORLDFLOW_API_KEY=dev-worldflow-key
PROCESSOR_DEFAULT_ACQUIRER=worldflow

# API_KEY_PEPPER is an HMAC pepper, not a salt. Rotating it invalidates every live
# API key in the environment — see docs/runbooks/payzeno-api.md.
API_KEY_PEPPER=dev-api-key-pepper

# --- bus ----------------------------------------------------------------------
SNS_MERCHANT_TOPIC_ARN=arn:aws:sns:eu-west-1:000000000000:payzeno-merchants
SQS_LEDGER_QUEUE_URL=http://payzeno-localstack:4566/000000000000/payzeno-api-ledger
SQS_DLQ_URL=http://payzeno-localstack:4566/000000000000/payzeno-dlq-monitor

# postgres | redis. The redis store is selected for POST /v1/payment_intents only.
IDEMPOTENCY_TTL_HOURS=24
IDEMPOTENCY_LEASE_SECONDS=90

REFUND_WINDOW_DAYS=120

FLAG_LEDGER_OWNS_INVOICES=false
