# payzeno-api — every variable read by src/config/configuration.ts.
#
# This file is the contract. config.schema.ts validates the whole set at boot with
# class-validator and the process exits non-zero on the first failure, so a missing
# var is a crash-on-start, not a 500 an hour later. If you add a var here, add the
# field to ApiConfig (src/config/api-config.type.ts) and the rule to config.schema.ts
# in the same PR — CI checks the three lists match.
#
# Values below are the docker-compose ones. Nothing here is a real secret.

# --- runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=8080
LOG_LEVEL=debug
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# --- datastores ---------------------------------------------------------------
DATABASE_URL=postgres://payzeno:payzeno@payzeno-postgres-api:5432/payzeno_api
REDIS_URL=redis://payzeno-redis:6379/0

# --- payzeno-ledger (internal, mTLS in prod, shared secret everywhere else) ----
LEDGER_BASE_URL=http://payzeno-ledger:8000
INTERNAL_API_SECRET=dev-internal-secret-do-not-use-in-prod

# --- payzeno-billing-legacy (basic auth — hlegacy's service, do not "improve" it)
BILLING_LEGACY_BASE_URL=http://payzeno-billing-legacy:8090
BILLING_LEGACY_USER=payzeno-api
BILLING_LEGACY_PASSWORD=dev-legacy-password

# --- card vault (PCI: the ONLY component that ever sees a PAN) -----------------
# VAULT_PUBLIC_URL is handed to the browser by the console for client-side
# tokenisation. VAULT_BASE_URL is server-to-server and must never be sent to a client.
VAULT_BASE_URL=http://payzeno-vault:8099
VAULT_PUBLIC_URL=http://localhost:8099
VAULT_API_KEY=dev-vault-key

# --- acquirers ----------------------------------------------------------------
WORLDFLOW_BASE_URL=http://payzeno-acquirer-sandbox:9100
WORLDFLOW_API_KEY=dev-worldflow-key
NORDPAY_BASE_URL=http://payzeno-acquirer-sandbox:9101
NORDPAY_API_KEY=dev-nordpay-key
PROCESSOR_DEFAULT_ACQUIRER=worldflow

# --- auth ---------------------------------------------------------------------
# API_KEY_PEPPER is an HMAC pepper, not a salt. Rotating it invalidates every live
# API key in the environment — see docs/runbooks/payzeno-api.md.
SESSION_SECRET=dev-session-secret-32-bytes-minimum-ok
CSRF_COOKIE_NAME=pz_csrf
API_KEY_PEPPER=dev-api-key-pepper

# --- webhooks -----------------------------------------------------------------
# KEK for the KMS envelope around each endpoint's signing secret (migration 24).
WEBHOOK_SIGNING_KEK=alias/payzeno-webhook-kek
WEBHOOK_MAX_ATTEMPTS=8
WEBHOOK_RETRY_WINDOW_HOURS=24

# --- bus ----------------------------------------------------------------------
AWS_REGION=eu-west-1
AWS_ENDPOINT_URL=http://payzeno-localstack:4566
SNS_PAYMENTS_TOPIC_ARN=arn:aws:sns:eu-west-1:000000000000:payzeno-payments
SNS_MERCHANT_TOPIC_ARN=arn:aws:sns:eu-west-1:000000000000:payzeno-merchants
SQS_LEDGER_QUEUE_URL=http://payzeno-localstack:4566/000000000000/payzeno-api-ledger
SQS_API_WEBHOOKS_URL=http://payzeno-localstack:4566/000000000000/payzeno-api-webhooks
SQS_CONSOLE_NOTIFICATIONS_URL=http://payzeno-localstack:4566/000000000000/payzeno-console-notifications
SQS_DLQ_URL=http://payzeno-localstack:4566/000000000000/payzeno-dlq-monitor

# --- idempotency --------------------------------------------------------------
# postgres | redis. The redis store is selected for POST /v1/payment_intents only.
# The two stores compute Retry-After slightly differently. Yes, we know.
IDEMPOTENCY_BACKEND=postgres
IDEMPOTENCY_TTL_HOURS=24
IDEMPOTENCY_LEASE_SECONDS=90

# --- limits and windows -------------------------------------------------------
RATE_LIMIT_DEFAULT_RPM=600
REFUND_WINDOW_DAYS=120

# --- feature flags (read ONLY by src/common/flags/env-feature-flags.ts) --------
FLAG_LEDGER_OWNS_INVOICES=false
FLAG_LEDGER_OWNS_FEES=true
FLAG_REDACT_PAN_IN_LOGS=true
