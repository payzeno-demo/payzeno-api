# payzeno-api code owners.
#
# Platform owns this repo. The extra lines exist because three surfaces here are
# operationally or contractually owned by someone else, and we would rather have the
# review request fire automatically than find out in an incident.
#
# One approval required (org default). Last matching pattern wins — that is a GitHub
# rule, not ours, so ordering below is deliberate: broad first, specific last.

*                                   @payzeno/platform

# --- the whole service ---------------------------------------------------------
/src/                               @payzeno/platform
/test/                              @payzeno/platform

# --- runtime and on-call surfaces: Infrastructure co-owns ----------------------
# Every job in here has a runbook and a pager rule attached to it. apager reviews
# anything that changes a schedule, a lock TTL or a batch size.
/src/jobs/                          @payzeno/platform @payzeno/infrastructure
/src/health/                        @payzeno/platform @payzeno/infrastructure
/src/common/lock/                   @payzeno/platform @payzeno/infrastructure
/src/common/logging/                @payzeno/platform @payzeno/infrastructure
/src/instrumentation.ts             @payzeno/infrastructure
/Dockerfile                         @payzeno/platform @payzeno/infrastructure
/docker-compose.override.yml        @payzeno/infrastructure
/.github/workflows/                 @payzeno/platform @payzeno/infrastructure
/.env.example                       @payzeno/platform @payzeno/infrastructure

# --- the money boundary: Core Payments co-owns ---------------------------------
# Anything that talks to payzeno-ledger or the legacy biller changes a contract that
# Core has to keep on the other side. arc MIG lives on both sides of this line.
/src/ledger/                        @payzeno/platform @payzeno/core
/src/billing/                       @payzeno/core @nmigration
/src/events/                        @payzeno/platform @payzeno/core
/src/migrations/                    @payzeno/platform @dhotfix

# --- PCI scope: named reviewers, not a team -----------------------------------
# docs/compliance/pci-scope.md is the SAQ-A-EP argument. If a diff here widens scope,
# the argument changes, and that is a conversation before it is a PR.
/src/common/redaction/              @dhotfix @osquash
/src/payments/vault/                @dhotfix @osquash
/docs/compliance/                   @dhotfix

# --- websocket relay: Web depends on the payload shape ------------------------
/src/notifications/                 @payzeno/platform @payzeno/web

# --- docs ---------------------------------------------------------------------
/docs/adr/                          @dhotfix @osquash
/docs/runbooks/                     @payzeno/infrastructure
/README.md                          @payzeno/platform
/CODEOWNERS                         @osquash
