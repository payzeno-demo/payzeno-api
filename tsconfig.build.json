{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "sourceMap": false,
    "declaration": false,
    "types": [
      "node"
    ],
    "rootDir": "./src",
    "paths": {
      "@payzeno/contracts": [
        "../payzeno-contracts/dist/index.d.ts"
      ],
      "@payzeno/contracts/*": [
        "../payzeno-contracts/dist/*.d.ts"
      ],
      "src/*": [
        "src/*"
      ]
    }
  },
  "exclude": [
    "node_modules",
    "dist",
    "coverage",
    "test",
    "**/*.spec.ts",
    "**/*.e2e-spec.ts"
  ]
}
