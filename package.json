{
  "name": "@payzeno/api",
  "version": "1.34.0",
  "private": true,
  "description": "Payzeno public REST API — auth, merchants, payment intents, refunds, disputes, webhooks",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.11 <21"
  },
  "packageManager": "pnpm@8.15.8",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "lint:fix": "eslint \"{src,test}/**/*.ts\" --fix",
    "format": "prettier --write \"{src,test}/**/*.ts\"",
    "test:watch": "jest --config jest.config.ts --watch",
    "test:cov": "jest --config jest.config.ts --coverage",
    "test:e2e": "jest --config jest.e2e.config.ts --runInBand",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/migrations/data-source.ts",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/migrations/data-source.ts",
    "jobs": "node dist/jobs/cli.js"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "3.577.0",
    "@aws-sdk/client-sqs": "3.577.0",
    "@nestjs/core": "10.3.7",
    "@nestjs/platform-express": "10.3.7",
    "@nestjs/platform-ws": "10.3.7",
    "@nestjs/typeorm": "10.0.2",
    "@nestjs/websockets": "10.3.7",
    "@opentelemetry/api": "1.8.0",
    "@opentelemetry/auto-instrumentations-node": "0.46.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.51.1",
    "@opentelemetry/resources": "1.24.1",
    "@opentelemetry/semantic-conventions": "1.24.1",
    "@payzeno/contracts": "workspace:*",
    "argon2": "0.40.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "cookie-parser": "1.4.6",
    "ioredis": "5.4.1",
    "opossum": "8.1.3",
    "pg": "8.11.5",
    "pino": "9.1.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "typeorm": "0.3.20",
    "undici": "6.18.0",
    "ws": "8.17.0"
  },
  "devDependencies": {
    "@nestjs/schematics": "10.1.1",
    "@nestjs/testing": "10.3.7",
    "@types/cookie-parser": "1.4.7",
    "@types/pg": "8.11.5",
    "@types/supertest": "6.0.2",
    "@types/ws": "8.5.10",
    "@typescript-eslint/eslint-plugin": "7.8.0",
    "@typescript-eslint/parser": "7.8.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-import-resolver-typescript": "3.6.1",
    "eslint-plugin-boundaries": "4.2.0",
    "jest": "29.7.0",
    "jest-junit": "16.0.0",
    "ts-jest": "29.1.2",
    "ts-node": "10.9.2",
    "typescript": "5.4.5"
  }
}
